<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="cv-entry">
        {% if content.startDate and content.startDate != '' %}
          {% assign startYear = content.startDate | split: '-' | first %}
          {% assign endRaw = content.endDate | default: '' %}
          {% if endRaw == '' %}
            {% assign endYear = 'Present' %}
          {% else %}
            {% assign endYear = endRaw | split: '-' | first %}
          {% endif %}
          <span class="cv-date">{{ startYear }} — {{ endYear }}</span>
        {% endif %}
        <h6 class="cv-entry-title">{{ content.studyType }}</h6>
        <p class="cv-entry-org">{{ content.institution }}{% if content.location %} · {{ content.location }}{% endif %}</p>
        {% if content.area %}
          <p class="cv-entry-area">{{ content.area }}</p>
        {% endif %}
        {% if content.score %}
          <p class="cv-entry-score">{{ content.score }}</p>
        {% endif %}
        {% if content.courses %}
          <ul class="cv-entry-highlights">
            {% for item in content.courses %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
