<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="cv-entry">
        {% if content.date %}
          {% assign awardYear = content.date | split: '-' | first %}
          <span class="cv-date">{{ awardYear }}</span>
        {% endif %}
        <h6 class="cv-entry-title">{{ content.title }}</h6>
        <p class="cv-entry-org">{{ content.awarder }}</p>
        {% if content.summary %}
          <p class="cv-entry-summary">{{ content.summary }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
