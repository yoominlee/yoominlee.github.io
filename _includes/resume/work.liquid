<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="cv-entry">
        {% if content.startDate %}
          {% assign startYear = content.startDate | split: '-' | first %}
          {% assign endRaw = content.endDate | default: '' %}
          {% if endRaw == '' %}
            {% assign endYear = 'Present' %}
          {% else %}
            {% assign endYear = endRaw | split: '-' | first %}
          {% endif %}
          <span class="cv-date">{{ startYear }} — {{ endYear }}</span>
        {% endif %}
        <h6 class="cv-entry-title">{{ content.position }}</h6>
        <p class="cv-entry-org">{{ content.name }}{% if content.location %} · {{ content.location }}{% endif %}</p>
        {% if content.summary %}
          <p class="cv-entry-summary">{{ content.summary }}</p>
        {% endif %}
        {% if content.highlights %}
          <ul class="cv-entry-highlights">
            {% for item in content.highlights %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
