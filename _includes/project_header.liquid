/* ── Active: opening quote version ──────────────────────────────────────── */
.proj-question-wrap {
  position: relative;
  text-align: center;
  padding: 1.6rem 2rem 2rem 2rem;
  margin: 0.5rem 0 2rem;
  border-top: 1px solid var(--global-divider-color);
  border-bottom: 1px solid var(--global-divider-color);
}

.proj-question-bg { display: none; }

.proj-question-wrap::before {
  content: '\201C';
  position: absolute;
  top: -0.15rem;
  left: 0.1rem;
  font-family: Georgia, serif;
  font-size: 5rem;
  line-height: 1;
  color: var(--global-theme-color);
  opacity: 0.75;
  pointer-events: none;
}

.proj-question {
  font-size: clamp(1.05rem, 2.5vw, 1.35rem);
  font-weight: 300;
  font-style: italic;
  color: var(--global-text-color);
  line-height: 1.65;
  margin: 0 auto;
  max-width: 580px;
}

/* ── Info sheet ──────────────────────────────────────────────────────────── */
.proj-tldr {
  border-left: 3px solid var(--global-theme-color);
  margin: 1.5rem 0 1.8rem;
  padding: 0.6rem 0 0.6rem 1.2rem;
  font-size: 0.95rem;
  font-weight: 400;
  font-style: normal;
  color: var(--global-text-color);
  line-height: 1.7;
  background: transparent;
}

.proj-info-sheet {
  display: flex;
  flex-wrap: wrap;
  border-top: 1px solid var(--global-divider-color);
  border-bottom: 1px solid var(--global-divider-color);
  margin: 0 0 1.8rem;
  padding: 0.9rem 0;
  gap: 0 2.5rem;
}

.proj-info-cell {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  min-width: 80px;
}

.proj-info-label {
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--global-text-color-light);
}

.proj-info-value {
  font-size: 0.82rem;
  font-weight: 400;
  color: var(--global-text-color);
  line-height: 1.4;
}

.proj-info-award {
  font-weight: 600;
  color: var(--global-theme-color);
}

.proj-intro-text {
  font-size: 0.95rem;
  font-weight: 300;
  line-height: 1.8;
  color: var(--global-text-color);
  margin: 0 0 1.5rem;
}

.proj-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 2rem;
}

.proj-link-btn {
  display: inline-block;
  padding: 0.25rem 0.9rem;
  border: 1px solid var(--global-text-color);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: var(--global-text-color) !important;
  text-decoration: none !important;
  transition: border-color 0.15s, color 0.15s;
}

.proj-link-btn:hover {
  border-color: var(--global-theme-color);
  color: var(--global-theme-color) !important;
}

/* ── Two-column preview (image left, text right) ─────────────────────────── */
.proj-two-col {
  display: grid;
  grid-template-columns: 42% 1fr;
  gap: 2rem;
  align-items: center;
  margin: 1.5rem 0;
}

.proj-two-col-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.proj-two-col-text {
  font-size: 0.88rem;
  font-weight: 300;
  line-height: 1.8;
  color: var(--global-text-color);
}

.proj-two-col-text p {
  margin-bottom: 0.9rem;
}

.proj-two-col-text p:last-child {
  margin-bottom: 0;
}

@media (max-width: 640px) {
  .proj-two-col {
    grid-template-columns: 1fr;
  }
}
</style>
