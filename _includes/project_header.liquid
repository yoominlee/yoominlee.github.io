{% comment %}
  Project page header component.
  Renders: TL;DR, horizontal info sheet, intro text, links, question block.

  Front matter fields (all optional):
    tldr:         one-sentence summary (tech)
    proj_intro:   one-paragraph intro text shown below info sheet
    award:        e.g. "1st Prize — SNU Ambient AI"
    proj_role:    e.g. "Team of 5"
    proj_dates:   e.g. "Aug–Sep 2024"
    proj_context: e.g. "Interior Architecture Studio 2"
    proj_tools:   e.g. "Rhino · Grasshopper · AutoCAD"
    proj_stack:   e.g. "PyTorch · Android · YOLO"
    links:        list of {label, url}
{% endcomment %}

{% if page.tldr %}
<blockquote class="proj-tldr">{{ page.tldr }}</blockquote>
{% endif %}

<div class="proj-info-sheet">
  {% if page.proj_dates %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Date</span>
    <span class="proj-info-value">{{ page.proj_dates }}</span>
  </div>
  {% endif %}
  {% if page.proj_role %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Role</span>
    <span class="proj-info-value">{{ page.proj_role }}</span>
  </div>
  {% endif %}
  {% if page.proj_context %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Context</span>
    <span class="proj-info-value">{{ page.proj_context }}</span>
  </div>
  {% endif %}
  {% if page.proj_tools %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Tools</span>
    <span class="proj-info-value">{{ page.proj_tools }}</span>
  </div>
  {% elsif page.proj_stack %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Stack</span>
    <span class="proj-info-value">{{ page.proj_stack }}</span>
  </div>
  {% elsif page.tags %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Tools</span>
    <span class="proj-info-value">{{ page.tags | join: ' · ' }}</span>
  </div>
  {% endif %}
  {% if page.award %}
  <div class="proj-info-cell">
    <span class="proj-info-label">Award</span>
    <span class="proj-info-value proj-info-award">{{ page.award }}</span>
  </div>
  {% endif %}
</div>

{% if page.proj_intro %}
<p class="proj-intro-text">{{ page.proj_intro }}</p>
{% endif %}

{% if page.links %}
<div class="proj-links">
  {% for link in page.links %}
  <a href="{{ link.url }}" target="_blank" class="proj-link-btn">{{ link.label }}</a>
  {% endfor %}
</div>
{% endif %}

{% if page.proj_question %}
<div class="proj-question-wrap">
  <p class="proj-question-bg" aria-hidden="true">{{ page.proj_question }}</p>
  <p class="proj-question">{{ page.proj_question }}</p>
</div>
{% endif %}

